{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumin",
  "version": "0.1.0",
  "identifier": "jp.lumin.learning.app",
  "build": {
    "beforeDevCommand": "bun run prepare:runtime && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run prepare:runtime && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumin",
        "width": 1024,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost https://huggingface.co; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "iOS": {
      "minimumSystemVersion": "26.0",
      "developmentTeam": ""
    },
    "android": {},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
