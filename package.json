{
  "name": "lumin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "tauri": "tauri",
    "ios:signing": "python3 scripts/setup_ios_signing.py",
    "ios:icons": "cp src-tauri/icons/ios/*.png src-tauri/gen/apple/Assets.xcassets/AppIcon.appiconset/",
    "ios:init": "bun run ios:signing && tauri ios init && bun run ios:signing && bun run ios:icons",
    "ios:dev": "tauri ios dev --host",
    "ios:build": "tauri ios build --target aarch64",
    "download:model": "bun run scripts/download_model.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "prepare:runtime": "python3 scripts/prepare_onnx_runtime.py"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@momics/dns-sd-tauri": "^0.1.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@vanilla-extract/css": "^1.21.2",
    "katex": "^0.18.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
